# Projeto Supabase "Paint it" (organização mar-nordico, região eu-west-1).
# São valores públicos: a chave "publishable" vai para o browser e a autorização
# é feita pelas políticas RLS. Nunca colocar aqui a chave secreta (service role).
NEXT_PUBLIC_SUPABASE_URL=https://phkfrabrjqbpnmocrrvj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0CdIAZ16RlNppJoUEmw2LA_KbAtMLus

# Só em testes: permite assinar sem PDF da Autenticação.gov (aceitação simples). Nunca em produção.
# PERMITIR_ACEITACAO_SIMPLES=1

# Stripe (modo de teste). Os valores secretos vão só para as variáveis do alojamento, nunca para aqui.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TAX_RATE_IVA=txr_...   (taxa de IVA 23% exclusiva, criada no Stripe; opcional)
# SUPABASE_SECRET_KEY=...        (chave secreta do Supabase, só para o webhook do Stripe)

# Avisos por email (Resend, chave com permissão só de envio). Sem ela, a plataforma funciona sem avisos.
RESEND_API_KEY=
NEXT_PUBLIC_EQUIVALENTE=0
# Chave da nif.pt (opcional): confirma NIPC e nome. Valor só na Vercel.
NIFPT_KEY=

# Faturação certificada (Moloni). Sem estas variáveis, a plataforma não emite documentos fiscais.
# Autenticação por OAuth: um administrador liga-se uma vez em /api/moloni/connect (ver docs/FATURACAO.md).
# MOLONI_CLIENT_ID=517588676          (Developer ID, Moloni > Configurações > Developers > Configuração da API)
# MOLONI_CLIENT_SECRET=                (aparece depois de ativar a API, na mesma página)
# MOLONI_REDIRECT_URI=https://quempinta.pt/api/moloni/callback   (tem de ser exatamente igual na Moloni)
# MOLONI_COMPANY_ID=517588676
# MOLONI_DOCUMENT_SET_ID=974940        (série "M", única nesta conta; usada para FT e NC — a confirmar se a Moloni aceita)
# MOLONI_TAX_ID_NORMAL=3934440         (IVA Normal, 23%)
# MOLONI_FINAL_CONSUMER_CUSTOMER_ID=162460860   (cliente "Consumidor Final" da conta)
